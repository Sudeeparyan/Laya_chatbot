# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored and must never be committed or submitted.
#
# All four settings are optional. Without them the converter still runs; the
# AI plugin, the cleaner's AI summary and the Knowledge Assistant chat answer
# are the parts that turn themselves off.

AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com
AZURE_OPENAI_API_KEY=your-api-key
AZURE_CHAT_DEPLOYMENT=gpt-4.1
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Leave this alone unless a TLS-inspecting corporate proxy blocks the calls.
# Setting it to false disables certificate verification on requests that carry
# your API key — a local workaround only, never for a deployed environment.
# AZURE_OPENAI_VERIFY_SSL=true
